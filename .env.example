# Supabase (project bmmwvxgxmesmgnrncoaj)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic - idea generation, critic, vision analysis
ANTHROPIC_API_KEY=

# fal.ai - image generation
FAL_KEY=

# Shared secret protecting cron routes and the fal webhook
CRON_SECRET=

# Basic-auth gate (middleware.ts) protecting every page and API route except
# the cron jobs and the fal webhook. Site is unauthenticated until both are set.
ADMIN_USER=
ADMIN_PASSWORD=

# Public base URL, used to build the fal webhook callback (no trailing slash)
PUBLIC_URL=https://apex-coach-marketing-assistant.vercel.app

# Instagram - OUT OF SCOPE, intentionally unset.
# While unset, the harvest cron skips publishing and metrics entirely.
# IG_ACCESS_TOKEN=
# IG_USER_ID=
